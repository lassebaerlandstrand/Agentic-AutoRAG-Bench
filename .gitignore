# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtualenvs
.venv/
.autorag-venv/

# Editor / OS
.idea/
.vscode/
.DS_Store

# Run artefacts inside the committed paper results/ tree — keep only the
# small per-method best_config + history + benchmark_results JSONs.
results/**/.cache/
results/**/lightrag/
results/**/run.log
results/**/optuna.db
results/**/optuna_sampler.pkl

# AutoRAG project_dir caches (subprocess outputs are big; we keep
# extracted_sample.yaml + translation_notes.json only).
results/**/autorag_project/data/
results/**/autorag_project/0/
results/**/autorag_project/resources/

# Benchmark data (corpus, splits, held-out gold, qa) is regeneratable via
# `agentic-autorag benchmark-prepare`, so it is not tracked. Keep only the
# validation exams (the Experiment-1 optimization target) + their provenance, so
# the exam that produced the results stays in git history.
benchmark_data/*
!benchmark_data/*/
benchmark_data/*/*
!benchmark_data/*/validation_exam.json
!benchmark_data/*/validation_exam_provenance.json

# Editor state
*.swp

# Logs
*.log
logs/

# Environment
.env

# Dev / exploratory run outputs: any `results_<variant>/` directory at the
# repo root (results_dev, results_smoke, results_larger, ...). The single
# committed `results/` tree above is the only one that ships with the paper;
# if a specific variant ever needs to ship, override with `!results_<name>/`.
results_*/

# Exploratory analysis artifacts paired with the results_* runs.
*_artifacts/

# Session-local scratch — not part of the shipped benchmark artifact.
/CLAUDE.md
/knowledge_base_render.md
*.out
configs/_canary_*
